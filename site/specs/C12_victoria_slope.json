{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Source Sans 3",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "gridColor": "#e0e5e2",
      "domain": false,
      "tickColor": "#c6cfcb",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "padding": 0,
      "offset": 16,
      "layout": {
        "anchor": "start",
        "frame": "bounds"
      }
    },
    "text": {
      "font": "Source Sans 3",
      "color": "#142f3c",
      "fontSize": 13
    }
  },
  "data": {
    "url": "data/victoria_annual.json"
  },
  "transform": [
    {
      "calculate": "isValid(datum.financial_year) ? replace(datum.financial_year, /[–-](\\d{2})$/, '–20$1') : null",
      "as": "display_financial_year"
    },
    {
      "calculate": "isValid(datum.year) ? replace(datum.year, /[–-](\\d{2})$/, '–20$1') : null",
      "as": "display_year"
    },
    {
      "calculate": "isValid(datum.label) ? replace(replace(datum.label, /(\\d{4})–(\\d{2})$/, '$1–20$2'), /([0-9.]+)m$/, '$1 million') : null",
      "as": "display_label"
    },
    {
      "calculate": "datum.band === 'Before AM peak' ? 'Before morning peak' : datum.band === 'AM peak' ? 'Morning peak' : datum.band === 'PM peak' ? 'Afternoon peak' : datum.band",
      "as": "display_band"
    },
    {
      "filter": "datum.financial_year !== '2025-26'"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 75
        }
      },
      "encoding": {
        "x": {
          "field": "display_financial_year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelExpr": "replace(datum.label, /[–-](\\d{2})$/, '–20$1')"
          },
          "title": "Financial year",
          "scale": {
            "padding": 0.4
          }
        },
        "y": {
          "field": "recovery_index",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)",
          "scale": {
            "domain": [
              50,
              140
            ]
          }
        },
        "color": {
          "field": "service",
          "type": "nominal",
          "scale": {
            "domain": [
              "Metropolitan",
              "Regional"
            ],
            "range": [
              "#21647a",
              "#a34e2e"
            ]
          },
          "legend": {
            "title": null
          },
          "title": "Service"
        },
        "tooltip": [
          {
            "field": "service",
            "type": "nominal",
            "title": "Service"
          },
          {
            "field": "display_financial_year",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "journeys_million",
            "type": "quantitative",
            "title": "Train journeys (million)",
            "format": ".2f"
          },
          {
            "field": "recovery_index",
            "type": "quantitative",
            "title": "Recovery index (2018–2019 = 100)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.financial_year === '2024-25'"
        },
        {
          "calculate": "format(datum.recovery_index, '.1f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 10,
        "align": "left",
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "display_financial_year",
          "type": "ordinal",
          "title": "Financial year"
        },
        "y": {
          "field": "recovery_index",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)"
        },
        "text": {
          "field": "label",
          "type": "nominal",
          "title": "City or total"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "ref": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#4e656d"
      },
      "encoding": {
        "y": {
          "field": "ref",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)"
        }
      },
      "transform": [
        {
          "calculate": "isValid(datum.financial_year) ? replace(datum.financial_year, /[–-](\\d{2})$/, '–20$1') : null",
          "as": "display_financial_year"
        },
        {
          "calculate": "isValid(datum.year) ? replace(datum.year, /[–-](\\d{2})$/, '–20$1') : null",
          "as": "display_year"
        },
        {
          "calculate": "isValid(datum.label) ? replace(replace(datum.label, /(\\d{4})–(\\d{2})$/, '$1–20$2'), /([0-9.]+)m$/, '$1 million') : null",
          "as": "display_label"
        },
        {
          "calculate": "datum.band === 'Before AM peak' ? 'Before morning peak' : datum.band === 'AM peak' ? 'Morning peak' : datum.band === 'PM peak' ? 'Afternoon peak' : datum.band",
          "as": "display_band"
        }
      ]
    }
  ],
  "description": "Department of Transport and Planning monthly totals from two complete financial years. Endpoints only; intervening changes are not shown. Method for estimating train transaction rates changed in January 2021."
}