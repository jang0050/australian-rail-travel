{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Source Sans 3",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "gridColor": "#e0e5e2",
      "domain": false,
      "tickColor": "#ccd5d1",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "padding": 0,
      "offset": 16,
      "layout": {
        "anchor": "start",
        "frame": "bounds"
      }
    },
    "text": {
      "font": "Source Sans 3",
      "color": "#142f3c",
      "fontSize": 13
    }
  },
  "projection": {
    "type": "azimuthalEqualArea",
    "rotate": [
      -145,
      38,
      0
    ],
    "center": [
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/lga_recovery.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "!isValid(datum.properties.recovery_index)"
        },
        {
          "calculate": "'No eligible matched stations'",
          "as": "recovery_status"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e3e7e5",
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.lga_name",
            "type": "nominal",
            "title": "Local government area"
          },
          {
            "field": "recovery_status",
            "type": "nominal",
            "title": "Recovery status"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/lga_recovery.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.properties.recovery_index)"
        },
        {
          "calculate": "datum.properties.recovery_index < 60 ? 'Below 60' : datum.properties.recovery_index < 80 ? '60 to below 80' : datum.properties.recovery_index < 100 ? '80 to below 100' : '100 or above'",
          "as": "recovery_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "recovery_class",
          "type": "ordinal",
          "sort": [
            "Below 60",
            "60 to below 80",
            "80 to below 100",
            "100 or above",
            "No eligible matched stations"
          ],
          "title": "Recovery index (2018–2019 = 100)",
          "scale": {
            "domain": [
              "Below 60",
              "60 to below 80",
              "80 to below 100",
              "100 or above",
              "No eligible matched stations"
            ],
            "range": [
              "#a34e2e",
              "#d39871",
              "#f2dfc5",
              "#21647a",
              "#e3e7e5"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "columnPadding": 28,
            "rowPadding": 8,
            "title": [
              "Recovery index · 2018–2019 = 100",
              "100 = full recovery"
            ],
            "titleLineHeight": 18,
            "labelLineHeight": 18,
            "titlePadding": 10,
            "titleLimit": 500,
            "labelLimit": 300,
            "labelFontSize": 13,
            "symbolType": "square"
          }
        },
        "tooltip": [
          {
            "field": "properties.lga_name",
            "type": "nominal",
            "title": "Local government area"
          },
          {
            "field": "properties.recovery_index",
            "type": "quantitative",
            "title": "Recovery index (2018–2019 = 100)",
            "format": ".1f"
          },
          {
            "field": "properties.station_count",
            "type": "quantitative",
            "title": "Matched stations",
            "format": ",.0f"
          },
          {
            "field": "properties.baseline_entries",
            "type": "quantitative",
            "title": "Annual station entries (2018–2019)",
            "format": ",.0f"
          },
          {
            "field": "properties.current_entries",
            "type": "quantitative",
            "title": "Annual station entries (2024–2025)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/stations.json"
      },
      "mark": {
        "type": "circle",
        "size": 7,
        "color": "#142f3c",
        "opacity": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/stations.json"
      },
      "transform": [
        {
          "filter": "datum.station_name === 'Flinders Street'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#4e656d",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "datum": 144.83
        },
        "latitude2": {
          "datum": -37.99
        }
      }
    },
    {
      "data": {
        "url": "data/stations.json"
      },
      "transform": [
        {
          "filter": "datum.station_name === 'Flinders Street'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontWeight": 600,
        "fontSize": 13,
        "lineHeight": 16
      },
      "encoding": {
        "longitude": {
          "datum": 144.83
        },
        "latitude": {
          "datum": -38.02
        },
        "text": {
          "value": [
            "Central",
            "Melbourne"
          ]
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Casey",
            "longitude": 145.3127021928372,
            "latitude": -38.09535350794815,
            "label_longitude": 145.1827021928372,
            "label_latitude": -37.97535350794815,
            "side": "right",
            "annotation_lines": [
              "Casey",
              "114.9"
            ]
          },
          {
            "name": "Mornington Peninsula",
            "longitude": 145.08252099803582,
            "latitude": -38.330394925491646,
            "label_longitude": 144.88252099803583,
            "label_latitude": -38.21039492549165,
            "side": "left",
            "annotation_lines": [
              "Mornington Peninsula",
              "59.8"
            ]
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#4e656d",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "label_latitude",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Casey",
            "longitude": 145.3127021928372,
            "latitude": -38.09535350794815,
            "label_longitude": 145.1827021928372,
            "label_latitude": -37.97535350794815,
            "side": "right",
            "annotation_lines": [
              "Casey",
              "114.9"
            ]
          },
          {
            "name": "Mornington Peninsula",
            "longitude": 145.08252099803582,
            "latitude": -38.330394925491646,
            "label_longitude": 144.88252099803583,
            "label_latitude": -38.21039492549165,
            "side": "left",
            "annotation_lines": [
              "Mornington Peninsula",
              "59.8"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.side === 'left' ? 'center' : 'right'"
        },
        "dx": {
          "expr": "datum.side === 'left' ? 0 : -4"
        },
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 15
      },
      "encoding": {
        "longitude": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation_lines",
          "type": "nominal"
        }
      }
    }
  ],
  "description": "Ratio of sums for stations matched by stable identifier and unchanged local government area, using original 2025 Australian Bureau of Statistics polygons. Colour measures recovery, not residents’ travel. Grey means no eligible matched stations."
}