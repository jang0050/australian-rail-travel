{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Source Sans 3",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "gridColor": "#e0e5e2",
      "domain": false,
      "tickColor": "#ccd5d1",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "padding": 0,
      "offset": 16,
      "layout": {
        "anchor": "start",
        "frame": "bounds"
      }
    },
    "text": {
      "font": "Source Sans 3",
      "color": "#142f3c",
      "fontSize": 13
    }
  },
  "data": {
    "url": "data/stations.json"
  },
  "params": [
    {
      "name": "baselineMin",
      "value": 5000
    }
  ],
  "transform": [
    {
      "filter": "datum.baseline_entries >= baselineMin && isValid(datum.recovery_index)"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#61737c",
        "binSpacing": 1
      },
      "encoding": {
        "x": {
          "field": "recovery_index",
          "type": "quantitative",
          "bin": {
            "step": 20
          },
          "title": "Recovery index (2018–2019 = 100)"
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "title": "Number of matched stations"
        },
        "tooltip": [
          {
            "bin": {
              "step": 20
            },
            "field": "recovery_index",
            "type": "quantitative",
            "title": "Recovery index interval"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Number of matched stations"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "ref": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#4e656d",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "ref",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "ref": 100,
            "label": "Back to baseline"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "dy": -7,
        "color": "#4e656d"
      },
      "encoding": {
        "x": {
          "field": "ref",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)"
        },
        "y": {
          "value": 18
        },
        "text": {
          "field": "label",
          "type": "nominal",
          "title": "City or total"
        }
      }
    }
  ],
  "description": "Frequency distribution in 20-point intervals; baseline threshold is selectable. All eligible extremes retained; each station counts once."
}