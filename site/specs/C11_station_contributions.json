{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Source Sans 3",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "gridColor": "#e0e5e2",
      "domain": false,
      "tickColor": "#c6cfcb",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "padding": 0,
      "offset": 16,
      "layout": {
        "anchor": "start",
        "frame": "bounds"
      }
    },
    "text": {
      "font": "Source Sans 3",
      "color": "#142f3c",
      "fontSize": 13
    }
  },
  "padding": {
    "left": 18,
    "right": 12,
    "top": 8,
    "bottom": 8
  },
  "data": {
    "url": "data/station_changes.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 20
      },
      "encoding": {
        "y": {
          "field": "station_name",
          "type": "nominal",
          "sort": [
            "Flinders Street",
            "Southern Cross",
            "Parliament",
            "Melbourne Central",
            "Flagstaff",
            "Hughesdale",
            "Berwick",
            "Cranbourne",
            "Merinda Park",
            "Craigieburn"
          ],
          "title": "Station",
          "axis": {
            "labelLimit": 160,
            "title": null
          }
        },
        "x": {
          "field": "change_million",
          "type": "quantitative",
          "title": "Change in annual station entries (million)",
          "axis": {
            "tickCount": 5
          },
          "scale": {
            "domain": [
              -11,
              2
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.change_entries >= 0",
            "value": "#21647a"
          },
          "value": "#a34e2e"
        },
        "tooltip": [
          {
            "field": "station_name",
            "type": "nominal",
            "title": "Station"
          },
          {
            "field": "baseline_entries",
            "type": "quantitative",
            "title": "Annual station entries (2018–2019)",
            "format": ",.0f"
          },
          {
            "field": "current_entries",
            "type": "quantitative",
            "title": "Annual station entries (2024–2025)",
            "format": ",.0f"
          },
          {
            "field": "change_entries",
            "type": "quantitative",
            "title": "Change in annual station entries",
            "format": "+,.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -5,
        "fontSize": 12
      },
      "transform": [
        {
          "filter": "datum.change_entries < 0"
        },
        {
          "calculate": "format(datum.change_million, '+.2f')",
          "as": "label"
        }
      ],
      "encoding": {
        "y": {
          "field": "station_name",
          "type": "nominal",
          "sort": [
            "Flinders Street",
            "Southern Cross",
            "Parliament",
            "Melbourne Central",
            "Flagstaff",
            "Hughesdale",
            "Berwick",
            "Cranbourne",
            "Merinda Park",
            "Craigieburn"
          ],
          "title": "Station"
        },
        "x": {
          "field": "change_million",
          "type": "quantitative",
          "title": "Change in annual station entries (million)"
        },
        "text": {
          "field": "label",
          "type": "nominal",
          "title": "City or total"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12
      },
      "transform": [
        {
          "filter": "datum.change_entries >= 0"
        },
        {
          "calculate": "format(datum.change_million, '+.2f')",
          "as": "label"
        }
      ],
      "encoding": {
        "y": {
          "field": "station_name",
          "type": "nominal",
          "sort": [
            "Flinders Street",
            "Southern Cross",
            "Parliament",
            "Melbourne Central",
            "Flagstaff",
            "Hughesdale",
            "Berwick",
            "Cranbourne",
            "Merinda Park",
            "Craigieburn"
          ],
          "title": "Station"
        },
        "x": {
          "field": "change_million",
          "type": "quantitative",
          "title": "Change in annual station entries (million)"
        },
        "text": {
          "field": "label",
          "type": "nominal",
          "title": "City or total"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "isValid(datum.financial_year) ? replace(datum.financial_year, /[–-](\\d{2})$/, '–20$1') : null",
      "as": "display_financial_year"
    },
    {
      "calculate": "isValid(datum.year) ? replace(datum.year, /[–-](\\d{2})$/, '–20$1') : null",
      "as": "display_year"
    },
    {
      "calculate": "isValid(datum.label) ? replace(replace(datum.label, /(\\d{4})–(\\d{2})$/, '$1–20$2'), /([0-9.]+)m$/, '$1 million') : null",
      "as": "display_label"
    },
    {
      "calculate": "datum.band === 'Before AM peak' ? 'Before morning peak' : datum.band === 'AM peak' ? 'Morning peak' : datum.band === 'PM peak' ? 'Afternoon peak' : datum.band",
      "as": "display_band"
    }
  ],
  "description": "Five largest positive and five largest negative absolute changes among 220 matched station identifiers. Other 210 stations omitted from this selected-extremes view."
}