{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Source Sans 3",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "gridColor": "#e0e5e2",
      "domain": false,
      "tickColor": "#ccd5d1",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "padding": 0,
      "offset": 16,
      "layout": {
        "anchor": "start",
        "frame": "bounds"
      }
    },
    "text": {
      "font": "Source Sans 3",
      "color": "#142f3c",
      "fontSize": 13
    }
  },
  "params": [
    {
      "name": "cityFocus",
      "value": "All cities"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "ref": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#4e656d"
      },
      "encoding": {
        "y": {
          "field": "ref",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)"
        }
      }
    },
    {
      "data": {
        "url": "data/national_history.json"
      },
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 24
        },
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal",
          "axis": {
            "title": "Year ending in June",
            "labelAngle": 0
          },
          "title": "Year ending in June"
        },
        "y": {
          "field": "recovery_index",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)",
          "scale": {
            "domain": [
              0,
              120
            ]
          }
        },
        "color": {
          "field": "city",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sydney",
              "Melbourne",
              "Brisbane",
              "Perth",
              "Adelaide"
            ],
            "range": [
              "#705287",
              "#82672f",
              "#3d745e",
              "#656870",
              "#a34f7b"
            ]
          },
          "legend": null,
          "title": "City"
        },
        "strokeDash": {
          "field": "city",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sydney",
              "Melbourne",
              "Brisbane",
              "Perth",
              "Adelaide"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                7,
                3
              ],
              [
                2,
                3
              ],
              [
                10,
                3,
                2,
                3
              ],
              [
                5,
                2,
                1,
                2
              ]
            ]
          },
          "legend": null,
          "title": "City"
        },
        "opacity": {
          "condition": {
            "test": "cityFocus === 'All cities' || datum.city === cityFocus",
            "value": 0.9
          },
          "value": 0.18
        },
        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "display_financial_year",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "trips_million",
            "type": "quantitative",
            "title": "Estimated heavy-rail journeys (million)",
            "format": ",.1f"
          },
          {
            "field": "recovery_index",
            "type": "quantitative",
            "title": "Recovery index (2018–2019 = 100)",
            "format": ".1f"
          }
        ]
      },
      "transform": [
        {
          "calculate": "isValid(datum.financial_year) ? replace(datum.financial_year, /[–-](\\d{2})$/, '–20$1') : null",
          "as": "display_financial_year"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "year_end": 2019,
            "ref": 100,
            "label": "2018–2019 level"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dy": -13,
        "fontSize": 13,
        "color": "#4e656d"
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal",
          "title": "Year ending in June"
        },
        "y": {
          "field": "ref",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)"
        },
        "text": {
          "field": "label",
          "type": "nominal",
          "title": "City or total"
        }
      }
    },
    {
      "data": {
        "url": "data/national_history.json"
      },
      "transform": [
        {
          "calculate": "isValid(datum.financial_year) ? replace(datum.financial_year, /[–-](\\d{2})$/, '–20$1') : null",
          "as": "display_financial_year"
        },
        {
          "filter": "cityFocus !== 'All cities' && datum.city === cityFocus"
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 55
        },
        "strokeWidth": 3.5
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal",
          "axis": {
            "title": "Year ending in June",
            "labelAngle": 0
          },
          "title": "Year ending in June"
        },
        "y": {
          "field": "recovery_index",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)",
          "scale": {
            "domain": [
              0,
              120
            ]
          }
        },
        "color": {
          "field": "city",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sydney",
              "Melbourne",
              "Brisbane",
              "Perth",
              "Adelaide"
            ],
            "range": [
              "#705287",
              "#82672f",
              "#3d745e",
              "#656870",
              "#a34f7b"
            ]
          },
          "legend": null,
          "title": "City"
        },
        "strokeDash": {
          "field": "city",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sydney",
              "Melbourne",
              "Brisbane",
              "Perth",
              "Adelaide"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                7,
                3
              ],
              [
                2,
                3
              ],
              [
                10,
                3,
                2,
                3
              ],
              [
                5,
                2,
                1,
                2
              ]
            ]
          },
          "legend": null,
          "title": "City"
        },
        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "display_financial_year",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "trips_million",
            "type": "quantitative",
            "title": "Estimated heavy-rail journeys (million)",
            "format": ",.1f"
          },
          {
            "field": "recovery_index",
            "type": "quantitative",
            "title": "Recovery index (2018–2019 = 100)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/national_history.json"
      },
      "transform": [
        {
          "calculate": "isValid(datum.financial_year) ? replace(datum.financial_year, /[–-](\\d{2})$/, '–20$1') : null",
          "as": "display_financial_year"
        },
        {
          "filter": "datum.year_end === 2025 && cityFocus !== 'All cities' && datum.city === cityFocus"
        },
        {
          "calculate": "datum.city + ' ' + format(datum.recovery_index,'.1f')",
          "as": "endpoint_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "dy": -15,
        "fontSize": 14,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal",
          "axis": {
            "title": "Year ending in June",
            "labelAngle": 0
          },
          "title": "Year ending in June"
        },
        "y": {
          "field": "recovery_index",
          "type": "quantitative",
          "title": "Recovery index (2018–2019 = 100)",
          "scale": {
            "domain": [
              0,
              120
            ]
          }
        },
        "text": {
          "field": "endpoint_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "display_financial_year",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "trips_million",
            "type": "quantitative",
            "title": "Estimated heavy-rail journeys (million)",
            "format": ",.1f"
          },
          {
            "field": "recovery_index",
            "type": "quantitative",
            "title": "Recovery index (2018–2019 = 100)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/national_history.json"
      },
      "transform": [
        {
          "pivot": "city",
          "value": "recovery_index",
          "groupby": [
            "year_end"
          ]
        },
        {
          "calculate": "(datum.year_end - 1) + '–' + datum.year_end",
          "as": "year_label"
        }
      ],
      "params": [
        {
          "name": "inspectYear",
          "select": {
            "type": "point",
            "fields": [
              "year_end"
            ],
            "nearest": true,
            "encodings": [
              "x"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 1
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal",
          "title": "Year ending in June"
        },
        "y": {
          "value": 0
        },
        "tooltip": [
          {
            "field": "year_label",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "Sydney",
            "type": "quantitative",
            "title": "Sydney · recovery index",
            "format": ".1f"
          },
          {
            "field": "Melbourne",
            "type": "quantitative",
            "title": "Melbourne · recovery index",
            "format": ".1f"
          },
          {
            "field": "Brisbane",
            "type": "quantitative",
            "title": "Brisbane · recovery index",
            "format": ".1f"
          },
          {
            "field": "Perth",
            "type": "quantitative",
            "title": "Perth · recovery index",
            "format": ".1f"
          },
          {
            "field": "Adelaide",
            "type": "quantitative",
            "title": "Adelaide · recovery index",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/national_history.json"
      },
      "transform": [
        {
          "pivot": "city",
          "value": "recovery_index",
          "groupby": [
            "year_end"
          ]
        },
        {
          "calculate": "(datum.year_end - 1) + '–' + datum.year_end",
          "as": "year_label"
        },
        {
          "filter": {
            "param": "inspectYear",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#4e656d",
        "strokeWidth": 1,
        "opacity": 0.5
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal",
          "title": "Year ending in June"
        }
      }
    }
  ],
  "description": "Separate Yearbook 2025 city estimates; five overlaid indexed series share a 2018–2019 baseline. City selection retains context. Nearest-year tooltips compare all cities on the same index."
}