{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Source Sans 3",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "gridColor": "#e0e5e2",
      "domain": false,
      "tickColor": "#c6cfcb",
      "labelPadding": 6,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "labelColor": "#142f3c",
      "titleColor": "#142f3c",
      "padding": 0,
      "offset": 16,
      "layout": {
        "anchor": "start",
        "frame": "bounds"
      }
    },
    "text": {
      "font": "Source Sans 3",
      "color": "#142f3c",
      "fontSize": 13
    }
  },
  "padding": {
    "left": 12,
    "right": 8,
    "top": 8,
    "bottom": 8
  },
  "data": {
    "url": "data/profiles.json"
  },
  "mark": {
    "type": "rect",
    "stroke": "#fff",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "display_band",
      "type": "ordinal",
      "sort": [
        "Before morning peak",
        "Morning peak",
        "Between peaks",
        "Afternoon peak",
        "Evening"
      ],
      "title": "Time band",
      "axis": {
        "labelAngle": 0,
        "labelLimit": 180,
        "title": null
      }
    },
    "y": {
      "field": "station_name",
      "type": "ordinal",
      "sort": [
        "Flinders Street",
        "Southern Cross",
        "Melbourne Central",
        "Parliament",
        "Footscray",
        "Richmond",
        "Flagstaff",
        "Caulfield",
        "South Yarra",
        "Box Hill",
        "Glenferrie",
        "Dandenong"
      ],
      "title": "Station",
      "axis": {
        "labelLimit": 155,
        "title": null
      }
    },
    "color": {
      "field": "share",
      "type": "quantitative",
      "title": "Share of five-band total (percent)",
      "scale": {
        "domain": [
          0,
          70
        ],
        "range": [
          "#e3eeef",
          "#21647a",
          "#142f3c"
        ]
      },
      "legend": {
        "gradientLength": 200
      }
    },
    "tooltip": [
      {
        "field": "station_name",
        "type": "nominal",
        "title": "Station"
      },
      {
        "field": "display_band",
        "type": "nominal",
        "title": "Time band"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of five-band total (percent)",
        "format": ".1f"
      },
      {
        "field": "entries",
        "type": "quantitative",
        "title": "Rounded normal-weekday station entries",
        "format": ",.0f"
      }
    ]
  },
  "transform": [
    {
      "calculate": "isValid(datum.financial_year) ? replace(datum.financial_year, /[–-](\\d{2})$/, '–20$1') : null",
      "as": "display_financial_year"
    },
    {
      "calculate": "isValid(datum.year) ? replace(datum.year, /[–-](\\d{2})$/, '–20$1') : null",
      "as": "display_year"
    },
    {
      "calculate": "isValid(datum.label) ? replace(replace(datum.label, /(\\d{4})–(\\d{2})$/, '$1–20$2'), /([0-9.]+)m$/, '$1 million') : null",
      "as": "display_label"
    },
    {
      "calculate": "datum.band === 'Before AM peak' ? 'Before morning peak' : datum.band === 'AM peak' ? 'Morning peak' : datum.band === 'PM peak' ? 'Afternoon peak' : datum.band",
      "as": "display_band"
    }
  ],
  "description": "Twelve largest annual-entry stations passing profile screens. Unequal-duration bands show shares of the published five-band sum, not an hourly arrival rate."
}